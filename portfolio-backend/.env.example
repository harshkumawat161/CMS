# ==========================================
# Portfolio CMS Platform - Environment Variables
# ==========================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/portfolio_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Security / JWT Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# File Storage Configuration (local or s3)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Initial Development Admin (Auto-seeded if no admin exists)
SEED_ADMIN=true
ADMIN_EMAIL=admin@portfolio.local
ADMIN_PASSWORD=Admin@123456
ADMIN_USERNAME=admin
