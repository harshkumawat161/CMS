# Root .gitignore for Full-Stack Portfolio CMS

# Secrets & Environment Configurations
.env
.env.*
!.env.example
*.env.local
.env.local

# Dependency directories
node_modules/
target/

# Build artifacts & bundles
dist/
build/
.next/
out/
*.jar
*.war

# Uploads and media storage
uploads/
backend/uploads/
portfolio-backend/uploads/


# IDE, OS, and Editor files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/
.nyc_output/
